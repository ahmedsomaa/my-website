  "provenance": {
    "bg.base": "port: editor.background",
    "bg.inset": "port: editor.background",
    "bg.surface": "port: sideBar.background",
    "bg.raised": "derived: list.hoverBackground (alpha) over bg",
    "bg.overlay": "port: editor.background",
    "fg.default": "port: editor.foreground",
    "fg.muted": "port: sideBar.foreground",
    "fg.faint": "port: terminal.ansiBrightBlack",
    "fg.on-accent": "choice: background colour on the accent",
    "border.default": "port: input.border",
    "accent.primary": "port: button.background",
    "accent.secondary": "port: terminal.ansiMagenta",
    "selection.bg": "derived: list.activeSelectionBackground (alpha) over bg",
    "selection.fg": "port: list.activeSelectionForeground",
    "selection.inactive.bg": "derived: list.hoverBackground (alpha) over bg",
    "text-selection.bg": "derived: editor.selectionBackground (alpha) over bg",
    "status.error": "port: editorError.foreground",
    "status.warning": "port: terminal.ansiYellow",
    "status.success": "port: terminal.ansiGreen",
    "status.info": "port: terminal.ansiBlue"
  },
  "ansi16": {},
  "notes": [
    "ANSI slots the theme does not set, copied from their normal/bright pair: terminal.ansiBlack (= background), terminal.ansiWhite (= text colour), terminal.ansiBrightBlack (= background), terminal.ansiBrightRed, terminal.ansiBrightGreen, terminal.ansiBrightYellow, terminal.ansiBrightBlue, terminal.ansiBrightMagenta, terminal.ansiBrightCyan, terminal.ansiBrightWhite (= text colour)"
  ]
}
