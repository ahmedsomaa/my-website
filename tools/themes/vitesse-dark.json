{
  "id": "vitesse-dark",
  "name": "Vitesse Dark",
  "scheme": "vitesse",
  "variant": "dark",
  "appearance": "dark",
  "license": "MIT (antfu/vscode-theme-vitesse)",
  "sources": {
    "app_port": "https://github.com/antfu/vscode-theme-vitesse (npm theme-vitesse 1.0.0, themes/*.json)",
    "terminal": "npm theme-vitesse 1.0.0 extra/xterm-vitesse-*.json"
  },
  "palette": {
    "bg": "#121212",
    "sel": "#181818",
    "line": "#191919",
    "green": "#4d9375",
    "red": "#cb7676",
    "orange": "#d4976c",
    "blue": "#6394bf",
    "cyan": "#5eaab5"
  },
  "terminal": {
    "background": "#121212",
    "foreground": "#cecabe",
    "cursor": null,
    "cursor_text": null,
    "selection_background": "#272727",
    "selection_foreground": null,
    "ansi": [
      "#393a34",
      "#cb7676",
      "#4d9375",
      "#e6cc77",
      "#6394bf",
      "#d9739f",
      "#5eaab5",
      "#dbd7ca",
      "#777777",
      "#cb7676",
      "#4d9375",
      "#e6cc77",
      "#6394bf",
      "#d9739f",
      "#5eaab5",
      "#ffffff"
    ]
  },
  "tokens": {
    "bg.base": "bg",
    "bg.inset": "bg",
    "bg.surface": "sel",
    "bg.raised": "line",
    "bg.overlay": "sel",
    "fg.default": "#cecabe",
    "fg.muted": "#858480",
    "fg.faint": "#52514f",
    "fg.on-accent": "#121212",
    "border.default": "#52514f",
    "border.focus": "green",
    "accent.primary": "green",
    "accent.secondary": "cyan",
    "selection.bg": "sel",
    "selection.fg": "#cecabe",
    "selection.inactive.bg": "sel",
    "text-selection.bg": "#272727",
    "status.error": "red",
    "status.warning": "orange",
    "status.success": "green",
    "status.info": "blue"
  },
  "provenance": {
    "bg.base": "port: editor.background",
    "bg.inset": "port: every panel uses the editor background",
    "bg.surface": "port: list.activeSelectionBackground (the only raised tone)",
    "bg.raised": "port: panel.border tone",
    "bg.overlay": "port: list.hoverBackground",
    "fg.default": "derived: editor.foreground over bg",
    "fg.muted": "derived: descriptionForeground over bg",
    "fg.faint": "derived: editorLineNumber.foreground over bg",
    "fg.on-accent": "port: button.foreground",
    "border.default": "choice: line-number tone; the official panel.border is too close to bg to outline panes",
    "border.focus": "port: button.background (focusBorder is transparent)",
    "accent.primary": "port: button.background, textLink.foreground",
    "accent.secondary": "choice: ANSI cyan, not used by a status role",
    "selection.bg": "port: list.activeSelectionBackground",
    "selection.fg": "port: list.activeSelectionForeground",
    "selection.inactive.bg": "port: list.inactiveSelectionBackground",
    "text-selection.bg": "derived: editor.selectionBackground over bg",
    "status.error": "port: editorError.foreground",
    "status.warning": "port: editorWarning.foreground",
    "status.success": "port: gitDecoration.addedResourceForeground",
    "status.info": "port: editorInfo.foreground"
  },
  "ansi16": {},
  "notes": [
    "Vitesse uses its accent green for success too; kept, it is the official mapping."
  ]
}
