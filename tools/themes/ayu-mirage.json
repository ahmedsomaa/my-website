  "provenance": {
    "bg.base": "port: editor.background",
    "bg.inset": "port: statusBar.background",
    "bg.surface": "port: sideBar/panel.background",
    "bg.raised": "port: editorWidget.background",
    "bg.overlay": "port: editorWidget.background",
    "fg.default": "derived: editor.foreground (alpha) over bg",
    "fg.muted": "derived: descriptionForeground (alpha) over bg",
    "fg.faint": "derived: editorLineNumber.foreground (alpha) over bg",
    "fg.on-accent": "port: button.foreground",
    "border.default": "derived: editorIndentGuide.activeBackground over bg; panel.border is darker than bg",
    "border.focus": "port: focusBorder",
    "accent.primary": "port: button.background, textLink.foreground",
    "accent.secondary": "port: syntax keyword colour",
    "selection.bg": "derived: list.activeSelectionBackground over bg",
    "selection.fg": "port: list.activeSelectionForeground = editor.foreground",
    "selection.inactive.bg": "derived: list.hoverBackground over bg",
    "text-selection.bg": "derived: editor.selectionBackground over bg",
    "status.error": "port: editorError.foreground",
    "status.warning": "port: editorWarning.foreground = accent",
    "status.success": "port: vcs added",
    "status.info": "port: gitDecoration.modifiedResourceForeground"
  },
  "ansi16": {},
  "notes": [
    "Ayu uses its accent for warnings too; kept, it is the official mapping."
  ]
}
