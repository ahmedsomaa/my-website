  "provenance": {
    "bg.base": "port: editor.background",
    "bg.inset": "port: editor.background",
    "bg.surface": "port: sideBar.background",
    "bg.raised": "derived: editorWidget.background (alpha) over bg",
    "bg.overlay": "derived: editorWidget.background (alpha) over bg",
    "fg.default": "port: foreground",
    "fg.muted": "derived: sideBar.foreground (alpha) over bg",
    "fg.faint": "derived: editorLineNumber.foreground (alpha) over bg",
    "fg.on-accent": "choice: background colour on the accent",
    "border.default": "port: editorGroup.border",
    "accent.primary": "choice: port: terminal.ansiMagenta; its neon pink; the button colour is a dull grey-purple",
    "accent.secondary": "port: terminal.ansiMagenta",
    "selection.bg": "derived: list.activeSelectionBackground (alpha) over bg",
    "selection.fg": "port: list.activeSelectionForeground",
    "selection.inactive.bg": "derived: list.hoverBackground (alpha) over bg",
    "text-selection.bg": "derived: editor.selectionBackground (alpha) over bg",
    "status.error": "port: editorError.foreground",
    "status.warning": "derived: editorWarning.foreground (alpha) over bg",
    "status.success": "derived: gitDecoration.addedResourceForeground (alpha) over bg",
    "status.info": "port: terminal.ansiBlue",
    "border.focus": "choice: port: terminal.ansiMagenta; its neon pink; the button colour is a dull grey-purple"
  },
  "ansi16": {},
  "notes": [
    "ANSI slots the theme does not set, copied from their normal/bright pair: terminal.ansiBlack (= background), terminal.ansiWhite (= text colour), terminal.ansiBrightBlack (= background), terminal.ansiBrightWhite (= text colour)"
  ]
