  "scheme": "vesper",
  "variant": "main",
  "appearance": "dark",
  "license": "MIT (raunofreiberg/vesper)",
  "sources": {
    "app_port": "https://github.com/raunofreiberg/vesper/blob/main/themes/Vesper-dark-color-theme.json",
