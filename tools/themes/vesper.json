    "sel": "#232323",
    "hover": "#282828",
    "line": "#343434",
    "gray5": "#505050",
    "gray7": "#7E7E7E",
    "gray": "#A0A0A0",
    "fg": "#FFFFFF",
    "peach": "#FFC799",
    "peach2": "#FFCFA8",
    "red": "#FF8080",
    "mint": "#99FFE4"
  },
  "terminal": {
    "background": "#101010",
    "foreground": "#ffffff",
    "cursor": null,
    "cursor_text": null,
    "selection_background": "#988049",
    "selection_foreground": null,
    "ansi": [
      "#101010",
      "#f5a191",
      "#90b99f",
      "#e6b99d",
      "#aca1cf",
      "#e29eca",
      "#ea83a5",
