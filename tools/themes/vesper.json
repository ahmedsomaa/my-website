  },
  "tokens": {
    "bg.base": "bg",
    "bg.inset": "bg",
    "bg.surface": "bg2",
    "bg.raised": "bg3",
    "bg.overlay": "bg3",
    "fg.default": "fg",
    "fg.muted": "gray",
    "fg.faint": "gray7",
    "fg.on-accent": "#000000",
    "border.default": "line",
    "border.focus": "peach",
    "accent.primary": "peach",
    "accent.secondary": "mint",
    "selection.bg": "sel",
    "selection.fg": "peach",
    "selection.inactive.bg": "hover",
    "text-selection.bg": "#333333",
    "status.error": "red",
    "status.warning": "peach",
    "status.success": "mint",
    "status.info": "peach2"
  },
  "provenance": {
    "bg.base": "port: editor.background",
    "bg.inset": "port: no tone below the editor background",
    "bg.surface": "port: ui colour #161616",
    "bg.raised": "port: ui colour #1C1C1C",
    "bg.overlay": "port: ui colour #1C1C1C",
    "fg.default": "port: editor.foreground",
    "fg.muted": "port: statusBar.foreground",
    "fg.faint": "port: ui colour #7E7E7E",
    "fg.on-accent": "port: button.foreground",
    "border.default": "port: ui colour #343434",
    "border.focus": "port: focusBorder",
    "accent.primary": "port: button.background, textLink.foreground",
    "accent.secondary": "port: editorGutter.addedBackground",
    "selection.bg": "port: list.activeSelectionBackground",
    "selection.fg": "port: list.activeSelectionForeground",
    "selection.inactive.bg": "port: list.hoverBackground",
    "text-selection.bg": "derived: editor.selectionBackground #FFFFFF25 over bg",
    "status.error": "port: editorError.foreground",
    "status.warning": "port: editorWarning.foreground",
    "status.success": "port: editorGutter.addedBackground",
    "status.info": "choice: the theme has no info colour; its light peach #FFCFA8"
  },
  "ansi16": {},
  "notes": [
    "Vesper uses its accent for warnings too; kept, it is the official mapping."
  ]
}
